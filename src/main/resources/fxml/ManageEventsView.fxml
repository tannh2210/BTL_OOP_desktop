<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="transparent-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nhom5.eventticket.ui.ManageEventController">
 <content>
  <VBox spacing="16" styleClass="view">
    <VBox spacing="5">
      <Label text="QUẢN LÝ SỰ KIỆN" styleClass="section-label"/>
      <Label text="Sự kiện và loại vé" styleClass="heading"/>
      <Label text="Thêm, sửa, xóa sự kiện. Cập nhật giá và tổng số lượng vé." wrapText="true" styleClass="muted-label"/>
    </VBox>
    <TextField fx:id="searchField" promptText="Tìm theo tên hoặc địa điểm..."/>
    <Button text="Nhập sự kiện mới" onAction="#newEvent" styleClass="secondary-button"/>
    <TableView fx:id="eventTable" prefHeight="220">
      <columns>
        <TableColumn fx:id="eventIdCol" text="Mã" prefWidth="90"/>
        <TableColumn fx:id="eventNameCol" text="Tên sự kiện" prefWidth="240"/>
        <TableColumn fx:id="locationCol" text="Địa điểm" prefWidth="160"/>
        <TableColumn fx:id="timeCol" text="Thời gian" prefWidth="160"/>
      </columns>
    </TableView>
    <VBox spacing="10" styleClass="panel">
      <Label text="Thông tin sự kiện" styleClass="panel-title"/>
      <Label fx:id="salesLabel"/>
      <Label fx:id="salesHint" wrapText="true" styleClass="hint-label"/>
      <Button fx:id="salesButton" text="Mở bán vé" onAction="#toggleSales" styleClass="secondary-button"/>
      <Label text="Tên sự kiện" styleClass="input-label"/>
      <TextField fx:id="nameField" promptText="Tên sự kiện"/>
      <Label text="Mô tả" styleClass="input-label"/>
      <TextArea fx:id="descriptionField" promptText="Mô tả ngắn" prefRowCount="2"/>
      <Label text="Địa điểm" styleClass="input-label"/>
      <TextField fx:id="locationField" promptText="Địa điểm"/>
      <Label text="Ngày tổ chức" styleClass="input-label"/>
      <DatePicker fx:id="datePicker"/>
      <Label text="Giờ bắt đầu (HH:mm)" styleClass="input-label"/>
      <TextField fx:id="startTimeField" text="19:00"/>
      <Label text="Ngày kết thúc" styleClass="input-label"/>
      <DatePicker fx:id="endDatePicker"/>
      <Label text="Giờ kết thúc (HH:mm)" styleClass="input-label"/>
      <TextField fx:id="endTimeField" text="22:00"/>
      <HBox spacing="10">
        <Button text="Thêm sự kiện" onAction="#addEvent" styleClass="primary-button"/>
        <Button text="Lưu sửa" onAction="#saveEvent" styleClass="secondary-button"/>
        <Button text="Xóa" onAction="#deleteEvent" styleClass="secondary-button"/>
      </HBox>
    </VBox>
    <VBox spacing="10" styleClass="panel">
      <Label text="Loại vé của sự kiện đang chọn" styleClass="panel-title"/>
      <ListView fx:id="ticketList" prefHeight="120"/>
      <Label text="Loại vé" styleClass="input-label"/>
      <ComboBox fx:id="typeBox" maxWidth="Infinity"/>
      <Label text="Giá vé (VND)" styleClass="input-label"/>
      <TextField fx:id="priceField" promptText="Ví dụ: 150000"/>
      <Label fx:id="priceError" style="-fx-text-fill: #c62828;" wrapText="true"/>
      <Label text="Tổng số lượng vé (bao gồm vé đã đặt)" styleClass="input-label"/>
      <TextField fx:id="quantityField" promptText="Ví dụ: 100"/>
      <Label fx:id="quantityError" style="-fx-text-fill: #c62828;" wrapText="true"/>
      <Label fx:id="stockLabel" text="" styleClass="hint-label"/>
      <HBox spacing="10">
        <Button text="Thêm loại vé" onAction="#addTicketType" styleClass="primary-button"/>
        <Button text="Cập nhật loại vé" onAction="#updateTicketType" styleClass="secondary-button"/>
      </HBox>
      <HBox spacing="10">
        <Button fx:id="deleteTicketButton" text="Xóa loại vé" onAction="#deleteTicketType" styleClass="secondary-button"/>
        <Button fx:id="ticketSalesButton" text="Ngừng bán loại vé" onAction="#toggleTicketSales" styleClass="secondary-button"/>
      </HBox>
    </VBox>
  </VBox>
 </content>
</ScrollPane>
