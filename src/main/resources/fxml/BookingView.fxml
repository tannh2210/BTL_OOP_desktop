<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="transparent-scroll"
 xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
 fx:controller="com.nhom5.eventticket.ui.BookingController">
 <content><VBox spacing="18" styleClass="view">
    <VBox spacing="5"><Label text="ĐẶT VÉ" styleClass="section-label" />
      <Label text="Chọn vé tham dự sự kiện" styleClass="heading"/>
      <Label text="Bạn có thể xem giá và đặt vé trong vài bước đơn giản." styleClass="muted-label"/>
    </VBox>
    <VBox spacing="14" styleClass="panel">
      <Label text="Thông tin đặt vé" styleClass="panel-title"/>
      <Label text="Sự kiện" styleClass="input-label"/><ComboBox fx:id="eventBox" maxWidth="Infinity"/>
      <Label text="Hạng vé" styleClass="input-label"/><ComboBox fx:id="typeBox" maxWidth="Infinity"/>
      <Label text="Số lượng" styleClass="input-label"/><Spinner fx:id="quantitySpinner" editable="false" />
      <Label fx:id="availabilityLabel" text="Số vé còn: -" styleClass="hint-label"/>
      <Separator />
      <HBox alignment="CENTER_LEFT" spacing="12"><Label text="Tạm tính" styleClass="panel-title"/>
      <Region HBox.hgrow="ALWAYS"/><Label fx:id="totalLabel" text="0 VND" styleClass="price-label"/></HBox>
      <HBox spacing="10"><Button text="Xác nhận đặt vé" onAction="#placeBooking" styleClass="primary-button"/>
      <Button text="Vé của tôi" onAction="#viewHistory" styleClass="secondary-button"/></HBox>
    </VBox>
    <VBox spacing="12" styleClass="panel">
      <Label text="Lịch sử đặt vé" styleClass="panel-title" />
      <ListView fx:id="bookingList" prefHeight="165" />
      <Button text="Hủy booking đã chọn" onAction="#cancelSelected" styleClass="secondary-button" />
    </VBox>
 </VBox></content>
</ScrollPane>