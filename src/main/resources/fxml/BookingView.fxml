<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="transparent-scroll"
 xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
 fx:controller="com.nhom5.eventticket.ui.BookingController">
 <content><VBox spacing="18" styleClass="view">
    <VBox spacing="5"><Label text="ĐẶT VÉ / BOOKING" styleClass="section-label" />
      <Label text="Đặt vé và quản lý booking" styleClass="heading"/>
      <Label text="Chọn vé tham dự sự kiện hoặc xem các booking đã tạo." styleClass="muted-label"/>
    </VBox>
    <VBox spacing="14" styleClass="panel">
      <Label fx:id="formHeading" text="Thông tin đặt vé" styleClass="panel-title"/>
      <Label text="Sự kiện" styleClass="input-label"/><ComboBox fx:id="eventBox" maxWidth="Infinity"/>
      <Label text="Hạng vé" styleClass="input-label"/><ComboBox fx:id="typeBox" maxWidth="Infinity"/>
      <Label text="Số lượng" styleClass="input-label"/><Spinner fx:id="quantitySpinner" editable="false" />
      <Label fx:id="availabilityLabel" text="Số vé còn: -" styleClass="hint-label"/>
      <Separator />
      <HBox alignment="CENTER_LEFT" spacing="12"><Label text="Tạm tính" styleClass="panel-title"/>
      <Region HBox.hgrow="ALWAYS"/><Label fx:id="totalLabel" text="0 VND" styleClass="price-label"/></HBox>
      <HBox fx:id="bookingActions" spacing="10">
        <Button fx:id="placeBookingButton" text="Xác nhận đặt vé" onAction="#placeBooking" styleClass="primary-button"/>
        <Button text="Làm mới" onAction="#viewHistory" styleClass="secondary-button"/>
      </HBox>
    </VBox>
    <VBox spacing="12" styleClass="panel">
      <Label fx:id="historyHeading" text="Lịch sử đặt vé" styleClass="panel-title" />
      <Label fx:id="policyLabel" wrapText="true" styleClass="muted-label" />
      <ComboBox fx:id="filterEventBox" maxWidth="Infinity" />
      <ListView fx:id="bookingList" prefHeight="240" />
      <Button fx:id="cancelButton" text="Hủy booking đã chọn" onAction="#cancelSelected" styleClass="secondary-button" />
    </VBox>
 </VBox></content>
</ScrollPane>