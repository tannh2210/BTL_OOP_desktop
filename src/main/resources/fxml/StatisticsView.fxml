<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox spacing="18" styleClass="view" xmlns="http://javafx.com/javafx/21"
 xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhom5.eventticket.ui.StatisticsController">
  <VBox spacing="5"><Label text="THỐNG KÊ" styleClass="section-label"/>
    <Label text="Tổng quan hoạt động" styleClass="heading"/>
    <Label text="Số liệu tách booking/vé còn hiệu lực và đã hủy. Doanh thu chỉ tính booking CONFIRMED." styleClass="muted-label" wrapText="true"/>
  </VBox>
  <HBox spacing="14">
    <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
      <Label text="Sự kiện" styleClass="stat-caption"/>
      <Label fx:id="events" text="0" styleClass="stat-number"/>
    </VBox>
    <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
      <Label text="Booking còn hiệu lực" styleClass="stat-caption"/>
      <Label fx:id="bookings" text="0" styleClass="stat-number"/>
      <Label fx:id="bookingDetail" text="" styleClass="stat-foot" wrapText="true"/>
    </VBox>
    <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
      <Label text="Vé còn hiệu lực" styleClass="stat-caption"/>
      <Label fx:id="tickets" text="0" styleClass="stat-number"/>
      <Label fx:id="ticketDetail" text="" styleClass="stat-foot" wrapText="true"/>
    </VBox>
  </HBox>
  <VBox spacing="10" styleClass="panel">
    <Label text="Doanh thu tạm tính" styleClass="panel-title"/>
    <Label fx:id="revenue" text="0 VND" styleClass="price-label"/>
    <Label text="Chỉ cộng booking CONFIRMED. Booking/vé đã hủy không tính vào doanh thu và không nằm trong ô số lớn phía trên." styleClass="hint-label" wrapText="true"/>
  </VBox>
</VBox>
