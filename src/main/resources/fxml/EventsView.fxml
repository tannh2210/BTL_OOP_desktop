<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.nhom5.eventticket.ui.EventController" styleClass="view">
 <top><VBox spacing="14">
    <VBox spacing="5">
      <Label text="SỰ KIỆN" styleClass="section-label"/>
      <Label text="Danh sách sự kiện" styleClass="heading"/>
      <Label text="Tìm theo tên, xem chi tiết, giá vé và số lượng còn lại." styleClass="muted-label" />
    </VBox>
    <TextField fx:id="searchField" promptText="Tìm theo tên hoặc địa điểm..." />
 </VBox></top>
 <center><TableView fx:id="eventTable" prefHeight="280">
   <columns>
      <TableColumn fx:id="eventIdCol" text="Mã" prefWidth="90"/>
      <TableColumn fx:id="eventNameCol" text="Tên sự kiện" prefWidth="240"/>
      <TableColumn fx:id="locationCol" text="Địa điểm" prefWidth="150"/>
      <TableColumn fx:id="timeCol" text="Thời gian" prefWidth="160"/>
      <TableColumn fx:id="statusCol" text="Trạng thái" prefWidth="100"/>
   </columns>
 </TableView></center>
 <bottom><VBox spacing="10" styleClass="panel">
     <Label text="CHI TIẾT SỰ KIỆN" styleClass="section-label" />
     <Label fx:id="eventDetail" text="Chọn một sự kiện." wrapText="true" styleClass="muted-label" />
     <Label text="Loại vé" styleClass="panel-title" />
     <ListView fx:id="ticketTypesList" prefHeight="110" />
     <Button fx:id="bookButton" text="Đến trang đặt vé" onAction="#goBooking" styleClass="primary-button"/>
 </VBox></bottom>
</BorderPane>
