<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<StackPane alignment="CENTER" styleClass="login-root"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.nhom5.eventticket.ui.LoginController">
  <VBox prefWidth="440" maxWidth="440" maxHeight="-Infinity" spacing="16" styleClass="login-card">
    <Label text="ET" styleClass="login-logo" />
    <VBox spacing="4">
      <Label fx:id="formTitle" text="Đăng nhập" styleClass="login-title" />
      <Label fx:id="formDescription" text="Đăng nhập để tiếp tục sử dụng ứng dụng." wrapText="true" styleClass="muted-label" />
    </VBox>
    <VBox fx:id="loginBox" spacing="8">
      <Label text="Tên đăng nhập" styleClass="input-label" />
      <TextField fx:id="loginUsernameField" promptText="Tên đăng nhập" onAction="#login" />
      <Label text="Mật khẩu" styleClass="input-label" />
      <PasswordField fx:id="loginPasswordField" promptText="Mật khẩu" onAction="#login" />
      <Button fx:id="loginButton" text="Đăng nhập" onAction="#login" defaultButton="true" styleClass="primary-button" maxWidth="Infinity" />
      <Button fx:id="registerLinkButton" text="Chưa có tài khoản? Đăng ký" onAction="#showRegister" styleClass="link-button" />
    </VBox>
    <VBox fx:id="registerBox" spacing="8" visible="false" managed="false">
      <Label text="Họ và tên" styleClass="input-label" />
      <TextField fx:id="fullNameField" promptText="Họ và tên" onAction="#register" />
      <Label text="Tên đăng nhập" styleClass="input-label" />
      <TextField fx:id="registerUsernameField" promptText="Tên đăng nhập" onAction="#register" />
      <Label text="Email" styleClass="input-label" />
      <TextField fx:id="emailField" promptText="Email" onAction="#register" />
      <Label text="Mật khẩu" styleClass="input-label" />
      <PasswordField fx:id="registerPasswordField" promptText="Mật khẩu" onAction="#register" />
      <Label text="Xác nhận mật khẩu" styleClass="input-label" />
      <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu" onAction="#register" />
      <Button fx:id="registerButton" text="Tạo tài khoản" onAction="#register" defaultButton="false" styleClass="primary-button" maxWidth="Infinity" />
      <Button text="Đã có tài khoản? Đăng nhập" onAction="#showLogin" styleClass="link-button" />
    </VBox>
    <Label fx:id="statusLabel" text="" wrapText="true" styleClass="form-error" />
    <Label text="Tài khoản dùng thử: customer / 123456 hoặc admin / 123456" wrapText="true" styleClass="hint-label" />
  </VBox>
</StackPane>
